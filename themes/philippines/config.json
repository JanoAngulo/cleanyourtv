{
  "dock_apps": [
    "com.disney.disneyplus",
    "com.wbd.stream",
    "com.netflix.ninja",
    "com.google.android.youtube.tv",
    "com.spotify.tv.android"
  ],
  "fill_dock": false,
  "columns": 5,
  "live_tv_package": "com.tcl.tv",
  "show_greeting": false,
  "icon_only_buttons": true,
