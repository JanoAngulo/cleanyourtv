  "wallpaper_dim": 25,
  "dock_glass": true,
  "dock_opacity": 70,
  "app_glow": true,
  "focus_overshoot": false,
  "background_color": "#0B1324",
  "stock_home_redirect": "com.google.android.apps.tv.launcherx",
  "key_filter": false,
  "restore_key_services": true,
  "power_on_home_always": true
